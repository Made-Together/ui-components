{
  "name": "bytogether-components",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "check": "biome check .",
    "check-types": "turbo run check-types",
    "size": "cd packages/ui && pnpm size",
    "test": "turbo run test",
    "clean": "find . \\( -name node_modules -o -name .turbo -o -name .next -o -name dist -o -name .cache -o -name tsconfig.tsbuildinfo \\) -prune -exec rm -rf '{}' +",
    "release": "turbo run build --filter=@togetheragency/ui && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@changesets/cli": "^2.31.0",
    "turbo": "^2.9.12",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "zod": "4.1.12"
    }
  }
}
