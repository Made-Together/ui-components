{
  "name": "bytogether-components",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "check": "biome check .",
    "check-types": "turbo run check-types",
    "size": "cd packages/ui && pnpm size",
    "test": "turbo run test",
    "clean": "find . \\( -name node_modules -o -name .turbo -o -name .next -o -name dist -o -name .cache -o -name tsconfig.tsbuildinfo \\) -prune -exec rm -rf '{}' +",
