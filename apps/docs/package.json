{
  "name": "docs",
  "version": "0.1.2",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "pnpm generate:changelog",
    "dev": "next dev --port 3001",
    "prebuild": "pnpm generate:changelog",
    "build": "next build",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind",
    "generate:changelog": "node ./scripts/generate-changelog.mjs",
    "start": "next start",
    "lint": "biome check .",
    "check-types": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@togetheragency/ui": "workspace:*",
    "@tailwindcss/postcss": "^4.3.0",
    "motion": "^12",
    "next": "16.2.0",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.14",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@togetheragency/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.2"
  }
