{
  "name": "@togetheragency/ui",
  "version": "0.3.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Made-Together/ui-components.git",
    "directory": "packages/ui"
  },
  "homepage": "https://ui.bytogether.agency",
  "bugs": {
    "url": "https://github.com/Made-Together/ui-components/issues"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "tailwind",
    "motion",
    "nextjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.mts",
      "import": "./dist/*/index.mjs",
      "require": "./dist/*/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown && size-limit",
    "dev": "tsdown --watch",
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.0",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "@types/react": "*",
    "@types/react-dom": "*",
    "motion": "^12",
    "react": "^17.0 || ^18.0 || ^19.0",
    "react-dom": "^17.0 || ^18.0 || ^19.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@togetheragency/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "embla-carousel": "^8.6.0",
    "jsdom": "^29.1.1",
    "size-limit": "^12.1.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.0",
    "unrun": "^0.3.0",
    "vitest": "^4.1.6"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "path": "dist/accordion/*.mjs",
      "import": "{ Accordion }",
      "limit": "10 KB"
    },
    {
      "path": "dist/carousel/*.mjs",
      "import": "{ Carousel }",
      "limit": "10 KB"
    },
    {
      "path": "dist/marquee/*.mjs",
      "import": "{ Marquee }",
      "limit": "10 KB"
    },
    {
      "path": "dist/number-flow/*.mjs",
      "import": "{ NumberFlow }",
      "limit": "10 KB"
    },
    {
      "path": "dist/scroll-stack/*.mjs",
      "import": "{ ScrollStack }",
      "limit": "10 KB"
    },
    {
      "path": "dist/swappable/*.mjs",
      "import": "{ Swappable }",
      "limit": "10 KB"
    },
    {
      "path": "dist/tabs/*.mjs",
      "import": "{ Tabs }",
      "limit": "10 KB"
    },
    {
      "path": "dist/ticker/*.mjs",
      "import": "{ Ticker }",
      "limit": "10 KB"
    },
    {
      "path": "dist/type-ahead/*.mjs",
      "import": "{ TypeAhead }",
      "limit": "10 KB"
    },
    {
      "path": "dist/text-reveal/*.mjs",
      "import": "{ TextReveal }",
      "limit": "10 KB"
    }
  ]
}
